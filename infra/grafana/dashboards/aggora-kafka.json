{
  "uid": "aggora-kafka",
  "title": "Aggora — Kafka",
  "tags": ["aggora", "kafka"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Lag por grupo de consumidores",
      "description": "Cuanto va cada grupo por detras de lo escrito. Si una linea sube sin parar, ese consumidor no da abasto o esta caido.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (consumergroup) (kafka_consumergroup_lag)",
          "legendFormat": "{{consumergroup}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Lag por topic",
      "description": "El mismo retraso, pero mirando que topic se queda atras (util para saber donde esta el cuello de botella).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (kafka_consumergroup_lag)",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Throughput por topic (mensajes/s)",
      "description": "Velocidad a la que crece el final del log de cada topic. Es la tasa de escritura.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (rate(kafka_topic_partition_current_offset[1m]))",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Mensajes descartados (DLT) por topic",
      "description": "Lo que va a los topics de descartes. Si sube, hay mensajes que no se pueden procesar y hay que mirarlos.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (kafka_topic_partition_current_offset{topic=~\".*DLT\"})",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Brokers vivos",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_brokers",
          "legendFormat": "brokers"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Lag total del sistema",
      "description": "Suma del retraso de todos los grupos. Es el numero que se mira cuando alguien dice 'va lento'.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_consumergroup_lag)",
          "legendFormat": "lag"
        }
      ]
    }
  ]
}
