{
    "name": "Aggora Dev",
    "image": "mcr.microsoft.com/devcontainers/java:21-bookworm",
    "features": {
      "ghcr.io/devcontainers/features/java:1": {
        "version": "21",
        "installMaven": true,
        "installGradle": true
      },
      // Docker DENTRO del devcontainer, la forma estandar: la feature monta el socket del host y
      // ademas instala el CLI de docker. Hacen falta LAS DOS cosas:
      //   - el socket, para que Testcontainers (Java) levante Kafka y Postgres en los tests de
      //     integracion y para que el plugin de Quarkus arranque el contenedor de Mandrel;
      //   - el CLI, porque el plugin de Quarkus lo INVOCA para compilar el nativo
      //     (sin el: "ContainerRuntimeUtil.detectContainerRuntime: no docker").
      "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
    },
    // OJO: aqui NO se toca workspaceMount/workspaceFolder. Se intento para que la ruta del
    // proyecto fuese la misma dentro y fuera (y asi el nativo pudiera montar el proyecto), pero en
    // un setup de VS Code en Windows + WSL ${localWorkspaceFolder} resuelve a una ruta de Windows
    // que no existe dentro del contenedor: VS Code responde "workspace does not exist" y te deja
    // sin entorno. La ruta del nativo se resuelve de otra forma (ver docs/decisions.md).
    // El devcontainer se une a aggora-net, para hablar con Kafka por NOMBRE (nunca localhost).
    // El acceso a Docker lo da la feature docker-outside-of-docker de arriba.
    // OJO: eso da al contenedor control sobre el Docker del host. Es comodo en la maquina de uno y
    // NO lo es en un devcontainer compartido.
    // El proyecto TAMBIEN se monta en la ruta que tiene en el host. Son las dos caras del mismo
    // directorio: /workspaces/aggora (la ruta de VS Code) y la del host. Hace falta asi porque al
    // compilar el binario nativo el plugin de Quarkus arranca un contenedor de Mandrel por el
    // socket y le monta el proyecto con la ruta que ve el: si el build se lanza desde
    // /home/noei/aggora/services, el host (que es quien monta) encuentra esa ruta; si se lanzara
    // desde /workspaces/aggora, no la encontraria.
    // AJUSTA LA RUTA del segundo montaje a la de tu repo en el host (en WSL2 suele ser
    // /home/<usuario>/<repo>).
    // Los puertos que VS Code reenvia al host. Hacen falta para DOS cosas, y por eso estan
    // declarados y no se dejan al azar del auto-descubrimiento:
    //   - ver las paginas en el navegador de Windows (las de demo de los dos gateways);
    //   - que Prometheus pueda scrapearlas: los servicios corren DENTRO del devcontainer y el
    //     Prometheus del compose llega por host.docker.internal, que solo responde para los
    //     puertos que el host de WSL2 tiene reenviados (ver infra/prometheus/prometheus.yml).
    "forwardPorts": [8089, 8189],
    "portsAttributes": {
      "8089": { "label": "gateway-ws (Spring)", "onAutoForward": "silent" },
      "8189": { "label": "gateway-ws (Quarkus)", "onAutoForward": "silent" }
    },
    "runArgs": [
      "--network=aggora-net",
      "--mount", "type=bind,source=/home/noei/aggora,target=/home/noei/aggora"
    ],
  
    "customizations": {
      "vscode": {
        "extensions": [
          "vscjava.vscode-java-pack",
          "vmware.vscode-spring-boot",
          "redhat.vscode-quarkus",
          "ms-azuretools.vscode-docker"
        ]
      }
    },
    "remoteUser": "vscode"
  }