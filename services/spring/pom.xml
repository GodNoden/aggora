<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Parent de los servicios de la implementacion SPRING (Fase 1).

    La otra implementacion (Quarkus, Fase 8) vive en services/quarkus con su propio
    parent: los dos cuelgan del agregador services/pom.xml, que no hereda de nadie.
    Heredar aqui de spring-boot-starter-parent nos da el dependencyManagement de
    Spring Boot y Java 21 sin escribir versiones.

    Boot 4.1.1: la migracion trajo Jackson 3 (paquete tools.jackson), el modulo
    spring-boot-kafka y los serializadores JacksonJson*. El detalle, en
    docs/decisions.md.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.aggora</groupId>
  <artifactId>aggora-spring-services</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>aggora-spring-services</name>
  <description>Servicios de Aggora en Spring Boot (plataforma de mercados globales sobre Kafka)</description>

  <modules>
    <module>market-data-simulator</module>
    <module>ingestion-normalizer</module>
    <module>analytics-streams</module>
    <module>order-matching-engine</module>
    <module>portfolio-risk</module>
    <module>alerting-service</module>
    <module>audit-log</module>
    <module>gateway-ws</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- La libreria de Avro de Confluent NO esta en Maven Central: vive en su
         repositorio, declarado mas abajo. 8.3.1 es la ultima y esta alineada con
         los clientes de Kafka 4.x que trae Spring Boot 4. La version del plugin de
         Avro se fija a la misma que arrastra esa libreria para que las clases
         generadas y el runtime no se desalineen. -->
    <confluent.version>8.3.1</confluent.version>
    <avro.version>1.12.1</avro.version>
    <!--
      Testcontainers: para los tests de integracion (*IT). Spring Boot importa el BOM de
      Testcontainers en su dependencyManagement, pero NO gestiona los modulos, asi que aqui se fija
      la version.

      DESVIACION DELIBERADA de la version que gestiona Boot (1.21.3): se sube a la 2.x, la MISMA
      linea que usa Quarkus, porque la 1.21.3 no sabe hablar con el socket de Docker Desktop del
      devcontainer y sus *IT solo podian correr en el CI. OJO con los nombres: en la 2.x los modulos
      se llaman testcontainers-<modulo>, no kafka ni postgresql a secas.
    -->
    <testcontainers.version>2.0.5</testcontainers.version>
  </properties>

  <!--
    Testcontainers solo para los tests de integracion (*IT), que levantan Kafka, el Schema Registry
    y Postgres DE VERDAD. Van en el padre y con scope test porque los *IT viven en los modulos cuyas
    fronteras prueban (el motor de matching, la auditoria...), y las versiones las decide Spring
    Boot, que ya importa el BOM de Testcontainers.
  -->
  <dependencies>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-kafka</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Failsafe: los tests de integracion (*IT) NO corren con `mvn test` (que es lo que se ejecuta
        en cada guardado), sino con `mvn verify`. Es la separacion de siempre: los unitarios en
        milisegundos, la integracion -que levanta contenedores- solo cuando toca.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <repositories>
    <repository>
      <id>confluent</id>
      <name>Confluent Maven Repository</name>
      <url>https://packages.confluent.io/maven/</url>
    </repository>
  </repositories>

</project>
