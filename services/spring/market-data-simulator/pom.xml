<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.aggora</groupId>
    <artifactId>aggora-spring-services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>market-data-simulator</artifactId>
  <name>market-data-simulator</name>
  <description>Genera ticks de mercado (referencia real + interpolación sintética) hacia market.ticks.raw</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-kafka</artifactId>
    </dependency>
    <!-- RestClient (spring-web) para el reference feed de Twelve Data.
         El servidor Tomcat que trae el starter se usará en la Fase 6 (actuator/Prometheus). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Serializadores Avro de Confluent: registran el esquema en el Schema
         Registry y meten el ID del esquema en cada mensaje. -->
    <dependency>
      <groupId>io.confluent</groupId>
      <artifactId>kafka-avro-serializer</artifactId>
      <version>${confluent.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Metricas de la aplicacion para Prometheus (Fase 8). El endpoint es
         /actuator/prometheus, y estas mismas series son las que se comparan con
         las de la version Quarkus. Solo lo llevan los servicios que YA tienen
         servidor web: anadir spring-boot-starter-web a los otros cinco solo para
         poder mirarles las metricas cambiaria justo lo que se quiere medir
         (memoria y tiempo de arranque). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Genera las clases Java a partir de los .avsc de services/schemas.
           No se escriben a mano: el esquema es la fuente de verdad. -->
      <plugin>
        <groupId>org.apache.avro</groupId>
        <artifactId>avro-maven-plugin</artifactId>
        <version>${avro.version}</version>
        <executions>
          <execution>
            <phase>generate-sources</phase>
            <goals>
              <goal>schema</goal>
            </goals>
            <configuration>
              <sourceDirectory>${project.basedir}/../../schemas</sourceDirectory>
              <outputDirectory>${project.build.directory}/generated-sources/avro</outputDirectory>
              <stringType>String</stringType>
              <enableDecimalLogicalType>true</enableDecimalLogicalType>
              <dateTimeLogicalTypeImplementation>JSR310</dateTimeLogicalTypeImplementation>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
